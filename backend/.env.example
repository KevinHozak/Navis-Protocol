# Reference only: export these in the launching process environment.
# NAVIS_ROOT must point to your external personal Vault.
NAVIS_ROOT=C:\Path\To\Your\Vault
NAVIS_API_KEY=
NAVIS_GCP_PROJECT=
NAVIS_GCS_BUCKET=
GOOGLE_API_KEY=
GEMINI_API_KEY=
# Optional JSON array of Markdown paths relative to NAVIS_ROOT.
# Empty means no therapy-note files are loaded automatically.
NAVIS_REID_NOTE_FILES=[]
