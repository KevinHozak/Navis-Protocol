      "../../backend/services/banter_generator.py": "backend/services/banter_generator.py",
      "../../backend/scripts/sync_watch_history.py": "backend/scripts/sync_watch_history.py",
      "../../backend/services/task_time.py": "backend/services/task_time.py",
      "../../backend/services/completed_today.py": "backend/services/completed_today.py",
      "../../backend/native_completed_tasks.py": "backend/native_completed_tasks.py"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
